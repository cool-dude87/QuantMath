{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run QuantMath",
            "type": "shell",
            "command": "cmake --build build && ./build/quantmath_test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}